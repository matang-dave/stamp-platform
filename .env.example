# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://localhost:5432/stamp_platform
PORT=3000

# HMAC key for signing pass IDs embedded in QR codes (any long random string)
QR_SIGNING_SECRET=

# Apple Wallet (milestone 4) — cert files live in ./certs/, gitignored
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=
APPLE_CERT_PATH=certs/pass.pem
APPLE_CERT_PASSWORD=

# Google Wallet (milestone 3)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_APPLICATION_CREDENTIALS=certs/google-service-account.json
